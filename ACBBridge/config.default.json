{
  "schema_version": 1,
  "instance": {
    "name": "ACBBridge",
    "display_name": "AI ChatButtons Bridge"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 17843,
    "max_request_bytes": 10485760
  },
  "output": {
    "root": "",
    "layout": "project_subdir",
    "history_mode": "latest_plus_history",
    "write_individual_waves": true,
    "write_combined_all3": true,
    "include_datetime_in_history_names": true,
    "newline": "lf",
    "history_retention_days": 0,
    "all3_format": "compact_v1"
  },
  "naming": {
    "project_max_length": 80,
    "latest_core": "{project}__01_AUDIT_CORE.md",
    "latest_second": "{project}__02_AUDIT_SECOND_WAVE.md",
    "latest_performance": "{project}__03_AUDIT_PERFORMANCE.md",
    "latest_all3": "{project}__00_AUDIT_ALL_3.md",
    "history_wave": "{project}__{wave_no}_{wave_slug}__{datetime}.md",
    "history_all3": "{project}__00_AUDIT_ALL_3__{datetime}.md"
  },
  "logging": {
    "level": "INFO",
    "max_bytes": 1048576,
    "backup_count": 5
  },
  "autostart": {
    "enabled": true
  }
}
